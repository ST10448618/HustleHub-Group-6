PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Frontend origin allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:3000

# Used ONLY by "npm run create-admin" (see src/scripts/createAdmin.js).
# Never commit real admin credentials.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Dev-only convenience: if true, the server will seed the admin account
# above on boot, from the ADMIN_* variables. NEVER true in production.
# Leave false unless you need a quick local admin login.
SEED_ADMIN_ON_BOOT=false