server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Do not advertise the nginx version.
  server_tokens off;

  # A static site only ever needs to be read.
  if ($request_method !~ ^(GET|HEAD)$) {
    return 405;
  }

  # Content-Security-Policy: scripts, styles, images and fonts may only
  # load from this site; network requests only to this site and the API.

  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # Browsers must not guess a file's type.

  add_header X-Content-Type-Options "nosniff" always;

  # Nobody may embed the app in a frame (clickjacking).

  add_header X-Frame-Options "DENY" always;

  add_header Referrer-Policy "no-referrer" always;

  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

  add_header Cross-Origin-Opener-Policy "same-origin" always;

  add_header Cross-Origin-Resource-Policy "same-origin" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Liveness probe used by the Docker healthcheck.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Vite fingerprints asset filenames, so they can be cached for a year.
  # (expires, not add_header, so the security headers above are kept.)
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # index.html must never be cached, or users keep an old bundle.
  location = /index.html {
    expires -1;
  }

  # Single-page app: unknown paths fall back to index.html so React
  # Router can handle them.
  location / {
    try_files $uri /index.html;
  }
}